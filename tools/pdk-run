#!/bin/sh
# pdk-run - launch a legacy webOS PDK game on LuneOS.
#
#   pdk-run <app-dir> <main-binary-relative-to-app-dir> [args...]
#
# Installed apps call this from their pdk-launch wrapper. Everything the games
# need that differs from a normal native app is set here.

PDK=${PDK_PREFIX:-/opt/pdk}
SYSROOT=${PDK_SYSROOT:-$PDK/sysroot}
APPDIR="$1"
BIN="$2"
shift 2 2>/dev/null || true   # anything left is for the game itself

[ -n "$APPDIR" ] && [ -n "$BIN" ] || { echo "usage: pdk-run <appdir> <binary>" >&2; exit 2; }

# Per-app quirks. Engines differ enough (resize handling, screen size, GLES
# level) that a few titles need overrides; install-games.sh writes these.
# set -a so plain KEY=value lines become exported - qemu only forwards the
# real environment, so an unexported shell variable never reaches the game.
[ -f "$APPDIR/pdk.env" ] && { set -a; . "$APPDIR/pdk.env"; set +a; }

# Retail titles open absolute paths into their own package (FIFA wants
# /vfs/data.vfs) because webOS ran PDK apps chrooted with the app dir as /.
# One game runs at a time, so a symlink is enough to emulate that.
[ -d "$APPDIR/vfs" ] && ln -sfn "$APPDIR/vfs" /vfs

# Run from the binary's own directory - games load assets relative to cwd.
BINDIR=$(dirname "$BIN")
BINNAME=$(basename "$BIN")
if [ "$BINDIR" != "." ]; then cd "$APPDIR/$BINDIR" || exit 1; else cd "$APPDIR" || exit 1; fi

# Screen size. Most titles ask for 0x0 ("native") and the SDL shim resolves it;
# a few insist on their own. Override per app with PDK_SCREEN_* in the environment.
#
# Ask DRM for the panel's mode rather than assuming the TouchPad's 1024x768. That
# default is wrong on every other device - a PineTab2 is 800x1280 - and it is not
# only cosmetic: the shim scales undersized modes up to this figure, so getting it
# wrong leaves the game rendering to a rectangle the display does not have.
if [ -z "$PDK_SCREEN_WIDTH" ] || [ -z "$PDK_SCREEN_HEIGHT" ]; then
    for status in /sys/class/drm/*/status; do
        [ -r "$status" ] || continue
        read -r state < "$status" 2>/dev/null || continue
        [ "$state" = "connected" ] || continue
        read -r mode < "${status%/status}/modes" 2>/dev/null || continue
        # modes look like 800x1280, sometimes with a trailing flag (1920x1080i)
        mw=${mode%%x*}
        mh=${mode#*x}
        mh=${mh%%[!0-9]*}
        case "$mw$mh" in
            *[!0-9]* | "") continue ;;
        esac
        [ "$mw" -gt 0 ] && [ "$mh" -gt 0 ] || continue
        : "${PDK_SCREEN_WIDTH:=$mw}"
        : "${PDK_SCREEN_HEIGHT:=$mh}"
        break
    done
fi
: "${PDK_SCREEN_WIDTH:=1024}"
: "${PDK_SCREEN_HEIGHT:=768}"

# llvmpipe spawns one thread per core and its synchronisation is expensive under
# emulation - more threads than this actively slows things down.
: "${LP_NUM_THREADS:=4}"

LIBPATH="/lib:/usr/lib:$APPDIR:$APPDIR/$BINDIR"

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/xdg}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
export SDL_VIDEODRIVER="${SDL_VIDEODRIVER:-wayland}"
export PULSE_SERVER="${PULSE_SERVER:-unix:/var/run/pulse/native}"
# Hardware GL, when a Mesa built for armel is installed beside the Debian one.
#
# Debian armel has no hardware driver at all: its Mesa 22.3 ships swrast plus a
# pile of kmsro display stubs, because armel targets ARMv5 hardware that never
# had a GPU. So llvmpipe was the only option and these titles ran at a few FPS
# on a device whose Mali-G52 was sitting idle.
#
# tools/mk-mesa26.sh cross-builds Mesa 26.2 with the panfrost driver and puts it
# in usr/lib/mesa26 - deliberately beside Debian's stack, not over it. That build
# has no llvmpipe (LLVM is a large dependency and panfrost does not need it), and
# a 26.2 libEGL cannot load Debian's 22.3 DRI drivers, so overwriting would leave
# nothing to fall back to when the hardware path fails. Set PDK_SOFTWARE_GL=1 to
# get the old behaviour.
MESA26="$SYSROOT/usr/lib/mesa26"
PDK_GL_LIBS=""
if [ -z "$PDK_SOFTWARE_GL" ] && [ -d "$MESA26/lib" ]; then
    PDK_GL_LIBS="$MESA26/lib"
    export __EGL_VENDOR_LIBRARY_DIRS="$MESA26/egl_vendor.d"
    [ -d "$MESA26/drirc.d" ] && export DRIRC_CONFIGDIR="$MESA26/drirc.d"
    export LIBGL_ALWAYS_SOFTWARE=0
elif [ -z "$PDK_SOFTWARE_GL" ] && [ -n "$(echo /dev/dri/renderD*)" ] \
     && [ -e "$(echo /dev/dri/renderD* | cut -d" " -f1)" ] \
     && { ls "$SYSROOT"/usr/lib/libgallium-*.so >/dev/null 2>&1 \
          || ls "$SYSROOT"/usr/lib/dri/*_dri.so >/dev/null 2>&1; }; then
    # The Yocto sysroot keeps Mesa in the normal place rather than a private
    # mesa26 tree, so the branch above never fires for it - and forcing
    # LIBGL_ALWAYS_SOFTWARE=1 here meant a device with a perfectly good GPU
    # rendered in llvmpipe. sargo is msm_drm/Adreno 615 with freedreno built
    # into the guest Mesa and /dev/dri/renderD128 present.
    #
    # Do not force hardware either: just stop forcing software and let Mesa pick,
    # so it falls back to llvmpipe by itself where there is no usable driver
    # (the emulator's vmwgfx, for which armel Mesa has no gallium driver).
    export LIBGL_ALWAYS_SOFTWARE="${LIBGL_ALWAYS_SOFTWARE:-0}"
else
    export LIBGL_ALWAYS_SOFTWARE="${LIBGL_ALWAYS_SOFTWARE:-1}"
fi

# The shim asks for fullscreen when a title hardcodes a mode smaller than the
# panel, and sdl12-compat does the scaling. Filter it - these are 320x480-era
# assets on a much larger screen, where nearest-neighbour is visibly blocky.
# OPENGL_SCALING covers the same path for GL titles, which render to an FBO.
export SDL12COMPAT_SCALE_METHOD="${SDL12COMPAT_SCALE_METHOD:-linear}"
export SDL12COMPAT_OPENGL_SCALING="${SDL12COMPAT_OPENGL_SCALING:-1}"

# libpdl reads this to find appinfo.json. Do not make it infer the app
# directory from /proc/self/exe: running natively through the sysroot loader
# that is ld-linux.so.3, and every title then reports appId=unknown.
export PDK_APP_DIR="$APPDIR"

export LP_NUM_THREADS PDK_SCREEN_WIDTH PDK_SCREEN_HEIGHT

if [ -n "$PDK_DEBUG" ]; then
    export PDK_SHIM_DEBUG=1 PDL_DEBUG=1 PDK_CINEMA_DEBUG=1 PDK_GLES_DEBUG=1
fi

# qemu writes a ~1GB core dump per crash into the app directory; on a device that
# fills the filesystem long before it helps anyone.
ulimit -c 0 2>/dev/null || true

# --- how to execute the guest binary ---------------------------------------
#
# On ARMv7 no emulator is involved. softfp and hardfp are the same instruction
# set - they differ only in whether float arguments travel in VFP registers - so
# the CPU runs these binaries natively. All that is needed is to point them at
# the soft-float sysroot, which means invoking its loader explicitly rather than
# the system one.
#
# arm64 counts as native too when the kernel carries CONFIG_COMPAT, i.e. it runs
# AArch32 at EL0. That covers the LuneOS arm64 devices checked so far - PineTab2
# (6.6) and tissot-halium (4.9) both set it - so they execute these binaries on
# the CPU rather than under emulation. uname -m still says aarch64 there, which
# is why this used to fall through to qemu; probe the 32-bit loader instead of
# trusting the machine name, and fall back if the kernel has no compat layer.
#
# Everywhere else (x86-64 emulator, arm64 without ARM32 userspace) the whole
# guest runs under qemu-user.

find_qemu() {
    for q in "$PDK/qemu-arm" "$PDK/qemu-arm-static" \
             /usr/bin/qemu-arm /usr/bin/qemu-arm-static; do
        [ -x "$q" ] && { echo "$q"; return 0; }
    done
    return 1
}

# aarch64 is opt-in (PDK_NATIVE=1), not automatic. AArch32 support is necessary
# but not sufficient: on sargo (halium 4.9) the loader runs, and so does a modern
# sysroot binary like curl, yet a 2010 PDK game dies with "invalid copy" before
# reaching any of our code - while the same binary runs fine under qemu. PineTab2
# (6.6) does execute them natively. Nothing cheap distinguishes the two, and
# guessing wrong costs every game on the device, so default to the path that
# always works and let a known-good device ask for the faster one.
NATIVE_OK=no
case "$(uname -m)" in
  armv7*|armv8l) NATIVE_OK=yes ;;
  # arm64 runs these natively when the kernel has CONFIG_COMPAT, and that is
  # worth having: under qemu-user the GPU is unreachable, because Mesa's
  # freedreno driver needs msm DRM ioctls that qemu does not translate, so
  # everything falls back to llvmpipe at a few frames a second. Native is also
  # where hardware GL becomes possible at all.
  #
  # Not every title survives it - BubbleBash trips its own anti-piracy check and
  # Lets Golf segfaults - so PDK_QEMU=1 forces emulation for those, per app
  # via pdk.env.
  aarch64) [ -z "$PDK_QEMU" ] && NATIVE_OK=yes ;;
esac

case "$NATIVE_OK" in
  yes)
    # head -n 1, not head -1: this runs on the target, where head is busybox's
    # and rejects the obsolete form. Only the ARM branch ever reaches it, so it
    # went unnoticed until this ran on a device.
    LOADER=$(ls "$SYSROOT"/lib/ld-linux.so.3 "$SYSROOT"/lib/ld-linux-armhf.so.3 2>/dev/null | head -n 1)
    # On aarch64 the loader is a 32-bit binary, so running it at all is the
    # test for AArch32 support: without CONFIG_COMPAT execve() returns ENOEXEC
    # and this fails, leaving us on the qemu path below.
    # Probing with "$LOADER --version" is not enough. On a halium aarch64 kernel
    # the loader itself runs happily - CONFIG_COMPAT is on - but loading a real
    # 32-bit application then dies with "invalid copy" before any of our code is
    # reached. Probe by running an actual executable from the sysroot instead;
    # if that fails, fall through to qemu, which works there.
    if [ -n "$LOADER" ]; then
        PROBE=
        for c in "$SYSROOT/usr/bin/curl" "$SYSROOT/bin/sh" "$SYSROOT/usr/bin/flac"; do
            [ -x "$c" ] && { PROBE=$c; break; }
        done
        if [ -n "$PROBE" ]; then
            "$LOADER" --library-path "$SYSROOT/lib:$SYSROOT/usr/lib" \
                      "$PROBE" --version >/dev/null 2>&1 || {
                echo "pdk-run: $(uname -m) cannot run 32-bit binaries natively, using emulation" >&2
                LOADER=
            }
        elif ! "$LOADER" --version >/dev/null 2>&1; then
            echo "pdk-run: $(uname -m) kernel has no AArch32 support, using emulation" >&2
            LOADER=
        fi
    fi
    if [ -n "$LOADER" ]; then
        # qemu-user is given -L "$SYSROOT" and so treats it as /, which quietly
        # fixes up the absolute RPATHs and multiarch paths baked into Debian's
        # libraries. Running natively there is no such prefix: libpulse's RPATH
        # of /usr/lib/arm-linux-gnueabi/pulseaudio resolves against the host,
        # where it is either absent or aarch64, and the dlopen of SDL2 fails
        # with "Failed loading SDL2 library". Name those directories explicitly.
        # The hardware Mesa goes first so its libEGL_mesa and libgbm win over
        # Debian's 22.3 ones, and so glvnd finds libgallium-26.2.0.so by name.
        SYSLIBS="${PDK_GL_LIBS:+$PDK_GL_LIBS:}$SYSROOT/lib:$SYSROOT/usr/lib"
        for d in "$SYSROOT/lib/arm-linux-gnueabi" \
                 "$SYSROOT/usr/lib/arm-linux-gnueabi" \
                 "$SYSROOT/usr/lib/arm-linux-gnueabi/pulseaudio" \
                 "$SYSROOT/usr/lib/pulseaudio"; do
            [ -d "$d" ] && SYSLIBS="$SYSLIBS:$d"
        done
        export LD_LIBRARY_PATH="$SYSLIBS:$APPDIR:$APPDIR/$BINDIR"
        # Same story for Mesa: its DRI driver directory and glvnd's EGL vendor
        # directory are compiled in as absolute paths, so natively they resolve
        # against the aarch64 host and EGL fails to initialise at all ("Unable
        # to set video: EGL not initialized"). Under qemu -L they landed inside
        # the sysroot for free.
        for d in "$SYSROOT/usr/lib/arm-linux-gnueabi/dri" "$SYSROOT/usr/lib/dri"; do
            [ -d "$d" ] && export LIBGL_DRIVERS_PATH="${LIBGL_DRIVERS_PATH:+$LIBGL_DRIVERS_PATH:}$d"
        done
        # Only when the hardware stack above has not already claimed it - that one
        # ships its own vendor json, and pointing glvnd at Debian's would load the
        # 22.3 libEGL_mesa instead and quietly put us back on llvmpipe.
        [ -z "$__EGL_VENDOR_LIBRARY_DIRS" ] && [ -d "$SYSROOT/usr/share/glvnd/egl_vendor.d" ] && \
            export __EGL_VENDOR_LIBRARY_DIRS="$SYSROOT/usr/share/glvnd/egl_vendor.d"
        [ -n "$PDK_PRELOAD" ] && export LD_PRELOAD="$PDK_PRELOAD"
        exec "$LOADER" --library-path "$LD_LIBRARY_PATH" "./$BINNAME" "$@"
    fi
    echo "pdk-run: no loader in $SYSROOT, falling back to emulation" >&2
    ;;
esac

QEMU=$(find_qemu) || {
    echo "pdk-run: no qemu-arm found and this is not an ARMv7 host" >&2
    exit 1
}

# No GALLIUM_DRIVER default. llvmpipe used to segfault here and this forced
# softpipe, at roughly 6x the cost - but that was never a qemu or Mesa problem:
# oe-core built LLVM for the target without setting LLVM_HOST_TRIPLE, so
# LLVM_NATIVE_TARGET was undefined, LLVMInitializeNativeTarget() registered
# nothing, and no execution engine could be created. Fixed in
# meta-luneos/recipes-devtools/llvm/llvm_%.bbappend; llvmpipe works now.

exec "$QEMU" -L "$SYSROOT" \
    -E LD_LIBRARY_PATH="$LIBPATH" \
    ${PDK_PRELOAD:+-E LD_PRELOAD=$PDK_PRELOAD} \
    "./$BINNAME" "$@"
