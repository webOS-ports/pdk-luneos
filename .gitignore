# Build output
build/

# The ARM softfp sysroot is generated by tools/mk-sysroot.sh. It is ~500MB and,
# more importantly, it contains proprietary Palm/HP libraries taken from a device
# image plus Debian binaries. Never commit it.
sysroot/
sysroot-*/

# Downloaded Debian packages and indexes (regenerated by mk-sysroot.sh)
pkgcache/

# Prebuilt host helpers (qemu-arm-static, lld, patchelf, gdb-multiarch).
# Fetched by tools/get-host-tools.sh; large and distro-provided.
tools/host/

# Reference material extracted from proprietary webOS images: decompiled sources,
# call maps and Palm binaries. Kept locally for development, never published -
# see docs/reverse-engineering.md.
reference/

# Test corpus / unpacked applications
testapp/
corpus/
corpus*/
games/
*.ipk

# Misc
*.o
*.so.bak
*.log
*.core
